# Production (docker-compose.prod.yml) : copier en .env et remplir.
# Le reverse proxy du serveur (Caddy) sert DOMAIN en HTTPS et renvoie vers 127.0.0.1:PORT.
DOMAIN=foot.benit.ooo
PORT=3001
# Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=
# Emails (confirmation d'inscription) : clé API Brevo (SMTP & API → Clés API) et expéditeur validé dans Brevo.
BREVO_API_KEY=
MAIL_FROM=
