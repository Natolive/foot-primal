# Production (docker-compose.prod.yml) : copier en .env et remplir.
# Le front répond sur DOMAIN, l'API sur api.DOMAIN : les deux doivent pointer vers le serveur.
DOMAIN=foot.example.com
# Adresse prévenue par Let's Encrypt (expiration des certificats).
ACME_EMAIL=admin@example.com
# Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=
